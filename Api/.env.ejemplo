# ---------------------------------------------------------------------------
# NOMBRE: .env.ejemplo
#
# ENTRADA: Ninguna. Las contraseñas se completan a mano.
#
# DESCRIPCION: Plantilla con la configuración de la API: puerto, firma de los
#              tokens, dirección de cada servidor y los usuarios con los que la
#              API entra a SQL Server.
#
# SALIDA: El archivo .env que lee la API al arrancar (server.js).
#
# OBJETIVO: Configurar la API sin subir contraseñas a GitHub.
#
# USO: cp .env.ejemplo .env   y luego cambie los textos entre comillas.
#
# IMPORTANTE: - El .env NO se sube a GitHub (está en .gitignore).
#             - Escriba las contraseñas entre comillas: un # sin comillas
#               corta el valor.
# ---------------------------------------------------------------------------

# Puerto donde escucha la API (http://localhost:4000)
PORT=4000

# Texto secreto para firmar los tokens de sesión (cualquier texto largo)
TOKEN_SECRET="cambie-este-texto-por-uno-largo"

# Corporativo: SQL Server instalado en Windows.
# "auto" = la API averigua sola la IP de Windows desde Ubuntu.
CORP_SERVER=auto
CORP_PORT=1433

# Sucursales: contenedores de Docker en Ubuntu (ver docker-compose.yml)
SJ_SERVER=localhost
SJ_PORT=1436
LM_SERVER=localhost
LM_PORT=1437

# Base de datos que usan los tres servidores
DB_DATABASE=WideWorldImporters

# Usuarios de SQL Server que usa la API (se crean en los scripts 10 y 11)
#   app_login        solo revisa usuario y contraseña al iniciar sesión
#   app_corporativo  solo lee los reportes del Corporativo (gerente)
#   app_admin        consulta y modifica los datos de una sucursal (administrador)
APP_LOGIN_USER=app_login
APP_LOGIN_PASSWORD="contraseña de app_login"
APP_CORP_USER=app_corporativo
APP_CORP_PASSWORD="contraseña de app_corporativo"
APP_ADMIN_USER=app_admin
APP_ADMIN_PASSWORD="contraseña de app_admin"